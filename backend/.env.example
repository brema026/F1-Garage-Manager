# Copy to backend/.env and provide local credentials. Never commit .env.
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
# Comma-separated exact origins; HTTPS origins are required in production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=f1_garage_tec
DB_USER=YOUR_LOCAL_DB_USER
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD
DB_ENCRYPT=true
# Local self-signed SQL Server only. Must be false in production.
DB_TRUST_SERVER_CERTIFICATE=true

# Milliseconds, 60000–86400000, in whole minutes (multiples of 60000).
# Used for both cookie and database expiration.
SESSION_TIMEOUT=3600000
LOG_LEVEL=info

# Used only by `npm run bootstrap-admin`; remove after the first Admin is created.
BOOTSTRAP_ADMIN_NAME=YOUR_LOCAL_ADMIN_NAME
BOOTSTRAP_ADMIN_EMAIL=YOUR_LOCAL_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=YOUR_LOCAL_ADMIN_PASSWORD
