# Copy to grafana/.env and replace the placeholders before starting Compose.
# Use single quotes around passwords containing $ to avoid Compose interpolation.
GRAFANA_ADMIN_USER=YOUR_LOCAL_GRAFANA_ADMIN
GRAFANA_ADMIN_PASSWORD='YOUR_LOCAL_GRAFANA_PASSWORD'
GRAFANA_DB_HOST=host.docker.internal:1433
GRAFANA_DB_NAME=f1_garage_tec
# Use a dedicated read-only login, not the backend's write-capable login.
GRAFANA_DB_USER=YOUR_READ_ONLY_DB_USER
GRAFANA_DB_PASSWORD='YOUR_READ_ONLY_DB_PASSWORD'
