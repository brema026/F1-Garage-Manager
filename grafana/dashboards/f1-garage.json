      "targets": [
        {
          "dataset": "f1_garage_tec",
          "datasource": {
            "type": "mssql",
            "uid": "f1-sqlserver"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  posicion,\r\n  equipo,\r\n  carro,\r\n  vrecta,\r\n  vcurva,\r\n  penalizacion,\r\n  tiempo_segundos\r\nFROM dbo.v_grafana_ranking_simulacion\r\nWHERE circuito = ${circuito:sqlstring}\r\n  AND id_simulacion = $simulation_id \r\nORDER BY posicion;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
