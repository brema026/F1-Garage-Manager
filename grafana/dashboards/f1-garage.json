      "targets": [
        {
          "dataset": "f1_garage_tec",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  fecha_simulacion AS time,\r\n  CAST(tiempo_segundos AS DECIMAL(12,3)) AS value,\r\n  CONCAT('Sim ', CAST(id_simulacion AS VARCHAR(10))) AS sim_label,\r\n  circuito AS circuito_label\r\nFROM dbo.v_grafana_carro_historial\r\nWHERE id_carro = $carro  -- Cambió de carro a id_carro\r\nORDER BY fecha_simulacion;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 500
