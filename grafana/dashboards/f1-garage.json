  "templating": {
    "list": [
      {
        "name": "circuito",
        "label": "circuito",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "f1-sqlserver"
        },
        "query": "SELECT DISTINCT circuito AS __text, circuito AS __value FROM dbo.v_grafana_carro_historial ORDER BY circuito;",
        "definition": "SELECT DISTINCT circuito AS __text, circuito AS __value FROM dbo.v_grafana_carro_historial ORDER BY circuito;",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "simulation_id",
        "label": "simulation_id",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "f1-sqlserver"
        },
        "query": "SELECT s.id_simulacion AS __text, s.id_simulacion AS __value FROM dbo.simulacion s JOIN dbo.circuito c ON c.id_circuito = s.id_circuito WHERE c.nombre = ${circuito:sqlstring} ORDER BY s.id_simulacion;",
        "definition": "SELECT s.id_simulacion AS __text, s.id_simulacion AS __value FROM dbo.simulacion s JOIN dbo.circuito c ON c.id_circuito = s.id_circuito WHERE c.nombre = ${circuito:sqlstring} ORDER BY s.id_simulacion;",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "carro",
        "label": "carro",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "f1-sqlserver"
        },
        "query": "SELECT DISTINCT CONCAT(equipo, ' - ', carro) AS __text, id_carro AS __value FROM dbo.v_grafana_carro_historial ORDER BY __text;",
        "definition": "SELECT DISTINCT CONCAT(equipo, ' - ', carro) AS __text, id_carro AS __value FROM dbo.v_grafana_carro_historial ORDER BY __text;",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
